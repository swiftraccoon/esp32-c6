# Preserve original device bytes, including mixed CRLF and LF framing.
**/results/**/serial.raw binary
# Timed read receipts are byte-bound evidence, with their original line endings.
**/results/**/observations.jsonl -text
# Monitor and transfer logs retain CR framing and progress bytes exactly.
**/results/**/monitor.log binary
**/results/**/console.log binary
**/results/**/flash.log binary
**/results/**/first-flash.log binary
**/results/**/flash-order-*.log binary
