builddir = build
build ALWAYS: phony
rule LINK_4144984674432776936
  command = test "${SKIP_CARGO_BUILD}" = "1" && exit 0; cd examples/hello-world &&  OPENOCD_ARGS="${OPENOCD_ARGS}" SCRIPTS=../../scripts CONFIG_BOARD=espressif-esp32-c6-devkitc-1 CARGO_BUILD_TARGET=riscv32imac-unknown-none-elf CARGO_TARGET_RISCV32IMAC_UNKNOWN_NONE_ELF_RUNNER="espflash flash --monitor" CARGO_TARGET_RISCV32IMAC_UNKNOWN_NONE_ELF_RUSTFLAGS="--cfg context=\"espressif-esp32-c6-devkitc-1\" --cfg context=\"esp32-c6-wroom-1\" --cfg context=\"esp32c6\" --cfg context=\"esp\" --cfg context=\"ariel-os\" --cfg context=\"default\" -Clink-arg=-Tlinkall.x --cfg stable -Cembed-bitcode=yes -Clto=fat -Ccodegen-units=1 --cfg capability=\"hw/device-identity\" -C force-frame-pointers --cfg context=\"riscv\" -Clink-arg=-Tisr_stack.x -Clink-arg=-Tlinkme-region-alias.x -Clink-arg=-Tlinkme.x" CARGO_TARGET_DIR=../../build/bin/espressif-esp32-c6-devkitc-1/cargo CONFIG_EXECUTOR_STACKSIZE=8192 CONFIG_ISR_STACKSIZE=4096 CHIP_NVM_SIZE_BYTES=${CHIP_NVM_SIZE_BYTES} CHIP_NVM_START_ADDRESS=${CHIP_NVM_START_ADDRESS} CHIP_NVM_PAGE_SIZE_BYTES=${CHIP_NVM_PAGE_SIZE_BYTES} CHIP_EXTRA_SECTIONS=${CHIP_EXTRA_SECTIONS} CHIP_RAM_START_ADDRESS=${CHIP_RAM_START_ADDRESS} CHIP_RAM_SIZE_BYTES=${CHIP_RAM_SIZE_BYTES} CHIP_LD_INCLUDES=${CHIP_LD_INCLUDES} CHIP_MEMORY_SECTION_RESERVE_BYTES=${CHIP_MEMORY_SECTION_RESERVE_BYTES} LOG_LEVEL=${LOG} ${CARGO_WRAPPER} cargo  --locked build --profile=release --features=ariel-os/esp-println,ariel-os/panic-printing,ariel-os/single-core,ariel-os/executor-thread,ariel-os/idle-threads,ariel-os/log,ariel-os/logging-over-uart ${POST_LINK}
  description = CARGO ${out}
  pool = console

build build/bin/espressif-esp32-c6-devkitc-1/cargo/riscv32imac-unknown-none-elf/release/hello-world: $
    LINK_4144984674432776936 $
    | $
    ALWAYS

rule LINK_4163264100927801235
  command = test "${SKIP_CARGO_BUILD}" = "1" && exit 0; cd examples/hello-world-threading &&  OPENOCD_ARGS="${OPENOCD_ARGS}" SCRIPTS=../../scripts CONFIG_BOARD=espressif-esp32-c6-devkitc-1 CARGO_BUILD_TARGET=riscv32imac-unknown-none-elf CARGO_TARGET_RISCV32IMAC_UNKNOWN_NONE_ELF_RUNNER="espflash flash --monitor" CARGO_TARGET_RISCV32IMAC_UNKNOWN_NONE_ELF_RUSTFLAGS="--cfg context=\"espressif-esp32-c6-devkitc-1\" --cfg context=\"esp32-c6-wroom-1\" --cfg context=\"esp32c6\" --cfg context=\"esp\" --cfg context=\"ariel-os\" --cfg context=\"default\" -Clink-arg=-Tlinkall.x --cfg stable -Cembed-bitcode=yes -Clto=fat -Ccodegen-units=1 --cfg capability=\"hw/device-identity\" -C force-frame-pointers --cfg context=\"riscv\" -Clink-arg=-Tisr_stack.x -Clink-arg=-Tlinkme-region-alias.x -Clink-arg=-Tlinkme.x" CARGO_TARGET_DIR=../../build/bin/espressif-esp32-c6-devkitc-1/cargo CONFIG_EXECUTOR_STACKSIZE=8192 CONFIG_ISR_STACKSIZE=4096 CHIP_NVM_SIZE_BYTES=${CHIP_NVM_SIZE_BYTES} CHIP_NVM_START_ADDRESS=${CHIP_NVM_START_ADDRESS} CHIP_NVM_PAGE_SIZE_BYTES=${CHIP_NVM_PAGE_SIZE_BYTES} CHIP_EXTRA_SECTIONS=${CHIP_EXTRA_SECTIONS} CHIP_RAM_START_ADDRESS=${CHIP_RAM_START_ADDRESS} CHIP_RAM_SIZE_BYTES=${CHIP_RAM_SIZE_BYTES} CHIP_LD_INCLUDES=${CHIP_LD_INCLUDES} CHIP_MEMORY_SECTION_RESERVE_BYTES=${CHIP_MEMORY_SECTION_RESERVE_BYTES} LOG_LEVEL=${LOG} ${CARGO_WRAPPER} cargo  --locked build --profile=release --features=ariel-os/esp-println,ariel-os/panic-printing,ariel-os/single-core,ariel-os/executor-thread,ariel-os/idle-threads,ariel-os/threading,ariel-os/log,ariel-os/logging-over-uart ${POST_LINK}
  description = CARGO ${out}
  pool = console

build build/bin/espressif-esp32-c6-devkitc-1/cargo/riscv32imac-unknown-none-elf/release/hello-world-threading: $
    LINK_4163264100927801235 $
    | $
    ALWAYS

